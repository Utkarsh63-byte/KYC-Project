{
  "info": {
    "name": "Enterprise Digital KYC Platform API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"reviewer@bankabc.com\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": { "raw": "{{base_url}}/api/v1/auth/login", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "login"] }
      }
    },
    {
      "name": "Create KYC Session",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Tenant-ID", "value": "BANK_ABC" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"full_name\": \"Rahul Sharma\",\n  \"email\": \"rahul.sharma@example.com\",\n  \"phone\": \"+91 9876543210\",\n  \"dob\": \"15/08/1992\",\n  \"address\": \"Flat 402, Green Park Heights, Bengaluru\"\n}"
        },
        "url": { "raw": "{{base_url}}/api/v1/kyc/sessions", "host": ["{{base_url}}"], "path": ["api", "v1", "kyc", "sessions"] }
      }
    },
    {
      "name": "Trigger Sandbox Scenario",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"scenario_key\": \"SUCCESSFUL_PASS\"\n}"
        },
        "url": { "raw": "{{base_url}}/api/v1/sandbox/scenarios", "host": ["{{base_url}}"], "path": ["api", "v1", "sandbox", "scenarios"] }
      }
    }
  ]
}
