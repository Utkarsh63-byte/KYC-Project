# Enterprise KYC Platform Configuration
PROJECT_NAME="Digital KYC & Identity Verification Platform"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="bank-enterprise-kyc-super-secret-jwt-encryption-key-change-in-prod"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (PostgreSQL primary, Async SQLite fallback for dev)
DATABASE_URL="sqlite+aiosqlite:///./kyc_platform.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://kyc_user:kyc_password@localhost:5432/kyc_db"

# Storage Provider Configuration (local / s3)
STORAGE_PROVIDER="local"
LOCAL_STORAGE_PATH="./data/storage"
AWS_S3_BUCKET_NAME="enterprise-kyc-documents-secure"
AWS_REGION="ap-south-1"

# Provider Mode (mock / production)
KYC_PROVIDER_MODE="mock"

# External AI Services Configuration
AWS_ACCESS_KEY_ID="mock_key"
AWS_SECRET_ACCESS_KEY="mock_secret"

# Risk Engine Threshold Configs
RISK_THRESHOLD_AUTO_APPROVE=20.0
RISK_THRESHOLD_MANUAL_REVIEW=75.0
QUALITY_MIN_SCORE=70.0
OCR_MIN_CONFIDENCE=80.0
LIVENESS_MIN_CONFIDENCE=85.0
FACE_MATCH_MIN_CONFIDENCE=80.0

# Security & Multi-Tenancy
ENFORCE_TENANT_ISOLATION=True
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=["image/jpeg", "image/png", "image/webp", "application/pdf"]
